# Every setting the app and compose read (design §13). `docker compose up`
# needs no .env: compose carries these defaults. Copy this file to .env only
# to override one. Read once at boot.

# --- api and migrate -------------------------------------------------------

# A postgres:// URL. Required; no default in code. Under compose, api and
# migrate both get it from docker-compose.yml, which builds it from the
# POSTGRES_* values below, so this line is not used there. Outside compose,
# api also reads a .env file, while migrate reads only the process
# environment: export the variable before running it. The value here points
# at the compose database's published port.
DATABASE_URL=postgres://workout:workout@127.0.0.1:55432/workout

# fatal, error, warn, info, debug or trace. Used by api and migrate.
LOG_LEVEL=info

# --- api only ----------------------------------------------------------------

# The port api listens on, an integer 1-65535. Inside compose it is always
# 3000; set API_PORT below to change the host port.
PORT=3000

# Database pool size, an integer 1-100.
DB_POOL_MAX=10

# Per-statement time limit for requests, an integer 100-60000 (ms). migrate
# runs without it.
DB_STATEMENT_TIMEOUT_MS=5000

# How often api reloads the exercise catalog, an integer 10-3600 (seconds).
CATALOG_REFRESH_SECONDS=300

# The admin routes' token, at least 32 characters when set. No default
# anywhere; empty means unset (the guard, once applied, then refuses every
# request).
ADMIN_API_TOKEN=

# --- compose only --------------------------------------------------------------

# Read by the postgres image. Development values; a real deployment injects
# its own.
POSTGRES_USER=workout
POSTGRES_PASSWORD=workout
POSTGRES_DB=workout

# Host ports: api, and PostgreSQL on 127.0.0.1 only.
API_PORT=3000
DB_HOST_PORT=55432
